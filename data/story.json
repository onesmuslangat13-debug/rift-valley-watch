def get_script_sections(script):
    """
    Build narration directly from the verified story JSON.

    The current news_engine outputs a verified story record,
    not separate hook/what_happened/context narration fields.
    """

    sections = []

    title = clean(
        script.get(
            "title",
            ""
        )
    )

    county = clean(
        script.get(
            "county",
            "the Rift Valley"
        )
    )

    summary = clean(
        script.get(
            "summary",
            ""
        )
    )

    facts = script.get(
        "verified_facts",
        []
    )

    official = script.get(
        "official_statement",
        {}
    )

    # --------------------------------------------------------
    # 1. HOOK
    # --------------------------------------------------------

    if title:
        sections.append(
            (
                "THE LATEST",
                f"Here is the latest development from {county}. "
                f"{title}."
            )
        )

    # --------------------------------------------------------
    # 2. WHAT HAPPENED
    # --------------------------------------------------------

    if summary:
        sections.append(
            (
                "WHAT HAPPENED",
                summary
            )
        )

    # --------------------------------------------------------
    # 3. KEY FACTS
    # --------------------------------------------------------

    fact_values = {}

    for item in facts:
        label = clean(
            item.get(
                "label",
                ""
            )
        ).upper()

        value = clean(
            item.get(
                "value",
                ""
            )
        )

        if label and value:
            fact_values[label] = value

    road_length = fact_values.get(
        "ROAD_LENGTH",
        ""
    )

    cost = fact_values.get(
        "COST",
        ""
    )

    location = fact_values.get(
        "LOCATION",
        county
    )

    status = fact_values.get(
        "STATUS",
        ""
    )

    if road_length or cost or location or status:
        parts = []

        if road_length:
            parts.append(
                f"The project covers {road_length}."
            )

        if cost:
            parts.append(
                f"The reported cost is {cost}."
            )

        if location:
            parts.append(
                f"It is located in {location}."
            )

        if status:
            parts.append(
                f"The current status is {status}."
            )

        sections.append(
            (
                "KEY FACTS",
                " ".join(parts)
            )
        )

    # --------------------------------------------------------
    # 4. IMPACT
    # --------------------------------------------------------

    impact = fact_values.get(
        "IMPACT",
        ""
    )

    if impact:
        sections.append(
            (
                "WHY IT MATTERS",
                f"The reported impact is that the project is {impact.lower()}."
            )
        )

    # --------------------------------------------------------
    # 5. OFFICIAL STATEMENT
    # --------------------------------------------------------

    if official.get("available"):
        speaker = clean(
            official.get(
                "speaker",
                ""
            )
        )

        quote = clean(
            official.get(
                "quote",
                ""
            )
        )

        if speaker and quote:
            sections.append(
                (
                    "OFFICIAL STATEMENT",
                    f"{speaker} said, \"{quote}\""
                )
            )

    # --------------------------------------------------------
    # 6. SOURCE / CLOSE
    # --------------------------------------------------------

    source = clean(
        script.get(
            "source",
            {}
        ).get(
            "name",
            "the official source"
        )
    )

    sections.append(
        (
            "SOURCE",
            f"This report is based on information from {source}. "
            f"This is Rift Valley Watch, tracking verified developments "
            f"across the region."
        )
    )

    if not sections:
        raise RuntimeError(
            "Unable to build narration from verified story data."
        )

    return sections
